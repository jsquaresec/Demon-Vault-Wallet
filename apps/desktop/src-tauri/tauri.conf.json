{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Demon Vault",
  "version": "0.0.1",
  "identifier": "com.demonvault.wallet",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Demon Vault",
        "width": 1360,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
